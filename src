    ENDIF.

    " Column 21 - Formula Key 04
    ASSIGN COMPONENT 21 OF STRUCTURE <ls_row> TO <lv_value>.
    IF sy-subrc = 0.
      gs_excel-for_key04 = <lv_value>.
    ENDIF.

    " Column 22 - Formula Key 05
    ASSIGN COMPONENT 22 OF STRUCTURE <ls_row> TO <lv_value>.
    IF sy-subrc = 0.
      gs_excel-for_key05 = <lv_value>.
    ENDIF.

    APPEND gs_excel TO gt_excel.

  ENDLOOP.
