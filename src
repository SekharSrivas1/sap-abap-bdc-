*&---------------------------------------------------------------------*
*& Form upload_excel
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM upload_excel .

   DATA:
    lv_filename   TYPE string,
    lv_filelength TYPE i,
    lt_bin_data   TYPE solix_tab,
    lv_xstring    TYPE xstring,
    lo_excel      TYPE REF TO cl_fdt_xl_spreadsheet,
    lt_worksheets TYPE if_fdt_doc_spreadsheet=>t_worksheet_names,
    lv_worksheet TYPE string,
    lo_data_ref   TYPE REF TO data.

  FIELD-SYMBOLS:
    <lt_data> TYPE STANDARD TABLE,
    <ls_row>  TYPE any,
    <lv_value> TYPE any.

  lv_filename = p_file.

  cl_gui_frontend_services=>gui_upload(
    EXPORTING
      filename   = lv_filename
      filetype   = 'BIN'
    IMPORTING
      filelength = lv_filelength
    CHANGING
      data_tab   = lt_bin_data
    EXCEPTIONS
      OTHERS     = 1 ).

  IF sy-subrc <> 0.
    MESSAGE 'Error while uploading Excel file' TYPE 'E'.
  ENDIF.

  lv_xstring = cl_bcs_convert=>solix_to_xstring(
                 it_solix = lt_bin_data ).

  TRY.

      lo_excel = NEW cl_fdt_xl_spreadsheet(
                    document_name = lv_filename
                    xdocument     = lv_xstring ).

    CATCH cx_fdt_excel_core INTO DATA(lx_excel).
      MESSAGE lx_excel->get_text( ) TYPE 'E'.

  ENDTRY.

  lo_excel->if_fdt_doc_spreadsheet~get_worksheet_names(
    IMPORTING
      worksheet_names = lt_worksheets ).

  READ TABLE lt_worksheets INDEX 1 INTO lv_worksheet.

  IF sy-subrc <> 0.
    MESSAGE 'No worksheet found in Excel file' TYPE 'E'.
  ENDIF.

  lo_data_ref = lo_excel->if_fdt_doc_spreadsheet~get_itab_from_worksheet(
                  worksheet_name = lv_worksheet ).

  ASSIGN lo_data_ref->* TO <lt_data>.

  IF <lt_data> IS NOT ASSIGNED.
    MESSAGE 'Unable to read Excel worksheet' TYPE 'E'.
  ENDIF.

  LOOP AT <lt_data> ASSIGNING <ls_row>.

    " Skip Excel header row
    IF sy-tabix = 1.
      CONTINUE.
    ENDIF.

    CLEAR gs_excel.

    " Column 1 - Plant
    ASSIGN COMPONENT 1 OF STRUCTURE <ls_row> TO <lv_value>.
    IF sy-subrc = 0.
      gs_excel-plant = <lv_value>.
    ENDIF.

    " Column 2 - Work Center
    ASSIGN COMPONENT 2 OF STRUCTURE <ls_row> TO <lv_value>.
    IF sy-subrc = 0.
      gs_excel-work_center = <lv_value>.
    ENDIF.

    " Column 3 - Rule 01
    ASSIGN COMPONENT 3 OF STRUCTURE <ls_row> TO <lv_value>.
    IF sy-subrc = 0.
      gs_excel-rule01 = <lv_value>.
    ENDIF.

    " Column 4 - Rule 02
    ASSIGN COMPONENT 4 OF STRUCTURE <ls_row> TO <lv_value>.
    IF sy-subrc = 0.
      gs_excel-rule02 = <lv_value>.
    ENDIF.

    " Column 5 - Rule 03
    ASSIGN COMPONENT 5 OF STRUCTURE <ls_row> TO <lv_value>.
    IF sy-subrc = 0.
      gs_excel-rule03 = <lv_value>.
    ENDIF.

    " Column 6 - Rule 04
    ASSIGN COMPONENT 6 OF STRUCTURE <ls_row> TO <lv_value>.
    IF sy-subrc = 0.
      gs_excel-rule04 = <lv_value>.
    ENDIF.

    " Column 7 - Rule 05
    ASSIGN COMPONENT 7 OF STRUCTURE <ls_row> TO <lv_value>.
    IF sy-subrc = 0.
      gs_excel-rule05 = <lv_value>.
    ENDIF.

    " Column 8 - Activity Type 01
    ASSIGN COMPONENT 8 OF STRUCTURE <ls_row> TO <lv_value>.
    IF sy-subrc = 0.
      gs_excel-act_typ01 = <lv_value>.
    ENDIF.

    " Column 9 - Activity Type 02
    ASSIGN COMPONENT 9 OF STRUCTURE <ls_row> TO <lv_value>.
    IF sy-subrc = 0.
      gs_excel-act_typ02 = <lv_value>.
    ENDIF.

    " Column 10 - Activity Type 03
    ASSIGN COMPONENT 10 OF STRUCTURE <ls_row> TO <lv_value>.
    IF sy-subrc = 0.
      gs_excel-act_typ03 = <lv_value>.
    ENDIF.

    " Column 11 - Activity Type 04
    ASSIGN COMPONENT 11 OF STRUCTURE <ls_row> TO <lv_value>.
    IF sy-subrc = 0.
      gs_excel-act_typ04 = <lv_value>.
    ENDIF.

    " Column 12 - Activity Type 05
    ASSIGN COMPONENT 12 OF STRUCTURE <ls_row> TO <lv_value>.
    IF sy-subrc = 0.
      gs_excel-act_typ05 = <lv_value>.
    ENDIF.

    " Column 13 - Activity Unit 01
    ASSIGN COMPONENT 13 OF STRUCTURE <ls_row> TO <lv_value>.
    IF sy-subrc = 0.
      gs_excel-act_unt01 = <lv_value>.
    ENDIF.

    " Column 14 - Activity Unit 02
    ASSIGN COMPONENT 14 OF STRUCTURE <ls_row> TO <lv_value>.
    IF sy-subrc = 0.
      gs_excel-act_unt02 = <lv_value>.
    ENDIF.

    " Column 15 - Activity Unit 03
    ASSIGN COMPONENT 15 OF STRUCTURE <ls_row> TO <lv_value>.
    IF sy-subrc = 0.
      gs_excel-act_unt03 = <lv_value>.
    ENDIF.

    " Column 16 - Activity Unit 04
    ASSIGN COMPONENT 16 OF STRUCTURE <ls_row> TO <lv_value>.
    IF sy-subrc = 0.
      gs_excel-act_unt04 = <lv_value>.
    ENDIF.

    " Column 17 - Activity Unit 05
    ASSIGN COMPONENT 17 OF STRUCTURE <ls_row> TO <lv_value>.
    IF sy-subrc = 0.
      gs_excel-act_unt05 = <lv_value>.
    ENDIF.

    " Column 18 - Formula Key 01
    ASSIGN COMPONENT 18 OF STRUCTURE <ls_row> TO <lv_value>.
    IF sy-subrc = 0.
      gs_excel-for_key01 = <lv_value>.
    ENDIF.

    " Column 19 - Formula Key 02
    ASSIGN COMPONENT 19 OF STRUCTURE <ls_row> TO <lv_value>.
    IF sy-subrc = 0.
      gs_excel-for_key02 = <lv_value>.
    ENDIF.

    " Column 20 - Formula Key 03
    ASSIGN COMPONENT 20 OF STRUCTURE <ls_row> TO <lv_value>.
    IF sy-subrc = 0.
